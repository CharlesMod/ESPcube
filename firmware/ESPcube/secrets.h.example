#pragma once

// Copy this file to secrets.h and fill in your own values.

const char *ssid = "your-wifi-ssid";
const char *password = "your-wifi-password";

// Shared secret for cube commands: messages arrive as "<token>:<CMD>".
// Must match TOKEN in the host-side config.py. Generate with:
//   openssl rand -hex 6
const char *wsToken = "change-me";

// Password required when flashing over the network (Arduino IDE network
// port / espota).
const char *otaPassword = "change-me-too";

// Location for sunrise/sunset, used to dim the cube after dark. Only needs
// to be roughly right — a degree of latitude shifts sunrise a few minutes.
const double kLatitude = 41.8781;
const double kLongitude = -87.6298;
// POSIX TZ string (NOT an "America/Chicago"-style name). This encodes the
// daylight-saving rules, so the cube follows DST on its own.
//   US Eastern:  "EST5EDT,M3.2.0,M11.1.0"
//   US Central:  "CST6CDT,M3.2.0,M11.1.0"
//   US Mountain: "MST7MDT,M3.2.0,M11.1.0"
//   US Pacific:  "PST8PDT,M3.2.0,M11.1.0"
//   UK:          "GMT0BST,M3.5.0/1,M10.5.0"
//   Central EU:  "CET-1CEST,M3.5.0,M10.5.0/3"
const char *kTimezone = "CST6CDT,M3.2.0,M11.1.0";
